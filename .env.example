# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# NOTE: The Setup tab can also persist this to data/setup.json at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Setup & Credentials (optional; can also be set from the Setup tab) ---
# N8N_BASE_URL: Base URL of the n8n instance, e.g. https://your-n8n.example.com
N8N_BASE_URL=""
# N8N_API_KEY: Public API key from n8n Settings -> n8n API. Enables the
# dashboard to detect/create credentials in n8n automatically.
N8N_API_KEY=""
# YOUTUBE_CLIENT_ID / YOUTUBE_CLIENT_SECRET: Google Cloud OAuth2 client for the
# YouTube Data API v3 (used by WF-10 to publish shorts).
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# --- Free AI LLM providers (optional; also settable from the Setup tab) ---
# Each can back the matching n8n chat-model node as a fallback provider.
GROQ_API_KEY=""
MISTRAL_API_KEY=""
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""
HUGGINGFACE_API_KEY=""
